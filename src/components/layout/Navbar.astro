---
import Container from '../common/Container.astro';
import { siteConfig } from '../../utils/site';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/75 backdrop-blur-xl">
  <Container class="flex h-16 items-center justify-between">
    <a href="#home" class="text-sm font-semibold tracking-wide text-white">
      {siteConfig.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        siteConfig.navItems.map((item) => (
          <a href={item.href} class="text-sm text-slate-300 transition hover:text-white">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={siteConfig.github}
      target="_blank"
      rel="noreferrer"
      class="rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 text-sm text-white transition hover:bg-white/[0.08]"
    >
      GitHub
    </a>
  </Container>
</header>
