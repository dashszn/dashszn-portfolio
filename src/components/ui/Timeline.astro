---
interface TimelineItem {
  title: string;
  subtitle?: string;
  period: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<div class="space-y-6">
  {
    items.map((item) => (
      <div class="relative rounded-3xl border border-white/10 bg-white/[0.04] p-6">
        <div class="mb-2 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h3 class="text-lg font-semibold text-white">{item.title}</h3>
            {item.subtitle && <p class="mt-1 text-sm text-slate-300">{item.subtitle}</p>}
          </div>
          <span class="rounded-full border border-sky-300/20 bg-sky-300/10 px-3 py-1 text-xs font-medium text-sky-200">
            {item.period}
          </span>
        </div>

        {item.description && <p class="mt-4 leading-7 text-slate-300">{item.description}</p>}
      </div>
    ))
  }
</div>
