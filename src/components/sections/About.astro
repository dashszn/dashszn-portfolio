---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Badge from '../common/Badge.astro';
import { profile } from '../../data/profile';
---

<section id="about" class="py-20">
  <Container>
    <SectionHeader
      eyebrow="About"
      title="A software engineer with a creative side."
      description="I am building my foundation as a full-stack developer while keeping my curiosity in AI, research, design, and meaningful technology."
    />

    <div class="grid gap-6 lg:grid-cols-[1.4fr_0.6fr]">
      <Card>
        <p class="leading-8 text-slate-300">
          {profile.summary}
        </p>

        <p class="mt-6 leading-8 text-slate-300">
          My long-term goal is to use software engineering, creativity, and business thinking to
          build technology that is useful, ethical, and valuable to people.
        </p>
      </Card>

      <Card>
        <h3 class="text-lg font-semibold text-white">Languages & Interests</h3>

        <div class="mt-5">
          <p class="mb-3 text-sm font-medium text-slate-400">Languages</p>
          <div class="flex flex-wrap gap-2">
            {profile.languages.map((language) => <Badge label={language} />)}
          </div>
        </div>

        <div class="mt-6">
          <p class="mb-3 text-sm font-medium text-slate-400">Interests</p>
          <div class="flex flex-wrap gap-2">
            {profile.interests.map((interest) => <Badge label={interest} />)}
          </div>
        </div>
      </Card>
    </div>
  </Container>
</section>
