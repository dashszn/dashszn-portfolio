---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Timeline from '../ui/Timeline.astro';
import { experiences } from '../../data/experience';
---

<section id="experience" class="py-20">
  <Container>
    <SectionHeader
      eyebrow="Experience"
      title="Real-world technical and business exposure."
      description="My early work experience gave me hands-on exposure to technical service, customer communication, social media, and small business operations."
    />

    <Timeline items={experiences} />
  </Container>
</section>
