---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Badge from '../common/Badge.astro';
import Card from '../ui/Card.astro';
import { skillGroups } from '../../data/skills';
---

<section id="skills" class="py-20">
  <Container>
    <SectionHeader
      eyebrow="Skills"
      title="What I can work with."
      description="My skills are grouped clearly so both technical and non-technical visitors can understand the areas I am developing."
    />

    <div class="grid gap-6 md:grid-cols-2">
      {
        skillGroups.map((group) => (
          <Card>
            <h3 class="text-xl font-semibold text-white">{group.title}</h3>
            <p class="mt-3 leading-7 text-slate-400">{group.description}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <Badge label={skill} />
              ))}
            </div>
          </Card>
        ))
      }
    </div>
  </Container>
</section>
