---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-3xl">
  {
    eyebrow && (
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.3em] text-sky-300/80">
        {eyebrow}
      </p>
    )
  }

  <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
    {title}
  </h2>

  {
    description && (
      <p class="mt-4 text-base leading-8 text-slate-300 sm:text-lg">
        {description}
      </p>
    )
  }
</div>
